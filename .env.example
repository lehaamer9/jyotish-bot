# Токен вашего Telegram бота (получить у @BotFather в Telegram)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Ключ API Google Gemini (получить бесплатно на https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Настройки монетизации (Telegram Stars / Звёзды XTR)
PAYMENT_REQUIRED=false
PRICE_CHART_STARS=150
PRICE_DASHA_STARS=100
PRICE_COMPAT_STARS=200
